{
  "name": "vw-melrose-finance-autofill",
  "version": "1.0.0",
  "description": "Browser automation for VW Melrose finance application form",
  "type": "module",
  "scripts": {
    "preview": "tsx src/previewSheet.ts",
    "build": "tsc",
    "start": "node dist/runBatch.js",
    "dev": "tsx src/runBatch.ts",
    "dry-run": "tsx src/runBatch.ts --dry-run",
    "retry": "tsx src/retryRows.ts",
    "renumber-rows": "tsx src/renumberRows.ts",
    "sync-loaded": "tsx src/syncLoadedSheet.ts",
    "test": "tsx --test src/outcome.test.ts src/transforms.test.ts src/sheetCsv.test.ts",
    "install-browsers": "playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fuse.js": "^7.5.0",
    "googleapis": "^174.0.1",
    "papaparse": "^5.5.4",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
