# Google Sheet CSV URL (public sheet, no auth required).
# Prefer gviz — /export often returns 502. fetchSheetCsv also retries and falls back.
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/12uKI418JWRhns8GQpWF1ACxlKc_zN-FcXL0NC_afMZI/gviz/tq?tqx=out:csv&gid=0

# Optional: path to mapping.json (defaults to ./mapping.json)
MAPPING_PATH=./mapping.json

# Run mode flags (can also pass via CLI)
DRY_RUN=false
STRICT_MODE=false
HEADLESS=false

# Process every sheet row (default). Set true / pass --skip-processed to skip already-done IDs.
SKIP_PROCESSED=false

# Leave the last applicant's browser open after the batch (headed live runs only)
KEEP_LAST_OPEN=false

# Write Status/Timing on the applicant sheet AND Name/Number on the loaded-clients sheet.
# Paste apps-script/Code.gs into Apps Script on either spreadsheet, deploy as a web app
# (Execute as Me, Who has access: Anyone), then paste the /exec URL here.
SHEET_WEBHOOK_URL=
# Optional: separate webhook for the loaded-clients sheet (defaults to SHEET_WEBHOOK_URL)
LOADED_SHEET_WEBHOOK_URL=
# Option B: path to a Google service account JSON (both sheets must be shared with that account)
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_ID=12uKI418JWRhns8GQpWF1ACxlKc_zN-FcXL0NC_afMZI
LOADED_SHEET_ID=1V8re1qmdC0AXyDKt9G3gQxcqmn3q9hAJeM_YpUkjRLM

# Which row(s) to process (1-based, comma-separated). Empty = all unprocessed rows.
ROW_FILTER=

# Random delay range between actions (milliseconds). Default 0 for speed.
ACTION_DELAY_MIN=0
ACTION_DELAY_MAX=0

# Gemini (Google Form intake → automation sheet)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
INTAKE_SPREADSHEET_ID=1P7J0CipLKDvPjeLWiKSxuC8ZeWSAjzhbDsQwKFwWH6M
INTAKE_STATUS_COLUMN=Enrichment Status
INTAKE_MAPPING_PATH=./config/intake-mapping.yaml
POLL_SECONDS=60
# After Gemini appends a row, run the Melrose loader on those new rows
AUTO_LOAD=true

# Leads WhatsApp (Status Approved/Declined → pre-approved message)
# Tab from the Leads sheet URL gid=1730847217
LEADS_SPREADSHEET_ID=1V8re1qmdC0AXyDKt9G3gQxcqmn3q9hAJeM_YpUkjRLM
LEADS_SHEET_GID=1730847217
LEADS_NAME_COLUMN=Name
LEADS_NUMBER_COLUMN=Number
LEADS_STATUS_COLUMN=Status
LEADS_WHATSAPP_SENT_COLUMN=WhatsApp sent

# Your WhatsApp API (no third-party BSP). Secrets stay in Node/.env — not Apps Script.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# Auth header defaults: Authorization: Bearer <key>. Set WHATSAPP_AUTH_SCHEME= for a raw key header.
WHATSAPP_AUTH_HEADER=Authorization
WHATSAPP_AUTH_SCHEME=Bearer
WHATSAPP_APPROVE_TEMPLATE=approve
WHATSAPP_DECLINE_TEMPLATE=decline
WHATSAPP_PHONE_FIELD=to
WHATSAPP_TEMPLATE_FIELD=template
WHATSAPP_NAME_FIELD=name
# Optional full JSON body override. Placeholders: {{phone}} {{template}} {{name}} {{status}} {{rowIndex}}
# WHATSAPP_BODY_TEMPLATE={"to":"{{phone}}","template":"{{template}}","name":"{{name}}"}

