# Google Sheet CSV export URL (public sheet, no auth required)
# Example: https://docs.google.com/spreadsheets/d/SHEET_ID/export?format=csv&gid=0
SHEET_CSV_URL=

# Optional: path to mapping.json (defaults to ./mapping.json)
MAPPING_PATH=./mapping.json

# Run mode flags (can also pass via CLI)
DRY_RUN=false
STRICT_MODE=true
HEADLESS=false

# Which row(s) to process (1-based, comma-separated). Empty = all unprocessed rows.
ROW_FILTER=

# Random delay range between actions (milliseconds)
ACTION_DELAY_MIN=200
ACTION_DELAY_MAX=800
