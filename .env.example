# Google Sheet — leave empty for product mode (per-client sheet IDs live in clients/*.json).
# For local CLI against one sheet, set SHEET_ID or SHEET_CSV_URL here.
SHEET_CSV_URL=
SHEET_ID=
LOADED_SHEET_ID=

# Optional: path to mapping.json (defaults to ./mapping.json)
MAPPING_PATH=./mapping.json

# Run mode flags (can also pass via CLI)
DRY_RUN=false
STRICT_MODE=false
HEADLESS=true

# Process every sheet row (default). Set true / pass --skip-processed to skip already-done IDs.
SKIP_PROCESSED=false

# Leave the last applicant's browser open after the batch (headed live runs only)
KEEP_LAST_OPEN=false

# Write Status/Timing on the applicant sheet AND Name/Number on the loaded-clients sheet.
# Prefer deployment id (survives secret redaction). Paste apps-script/Code.gs, deploy as web app
# (Execute as Me, Who has access: Anyone), then put the deployment id here.
SHEET_WEBHOOK_ID=
# Optional full URL fallback (often redacted in cloud envs — prefer SHEET_WEBHOOK_ID)
SHEET_WEBHOOK_URL=
LOADED_SHEET_WEBHOOK_URL=
# Option B: path to a Google service account JSON (both sheets must be shared with that account)
GOOGLE_SERVICE_ACCOUNT_FILE=

# Finance site (same Seriti iframe flow). Override only if needed later.
FINANCE_URL=https://vwmelrose.hatfieldgroup.co.za/finance

# Which row(s) to process (1-based, comma-separated). Empty = all unprocessed rows.
ROW_FILTER=

# Random delay range between actions (milliseconds). Default 0 for speed.
ACTION_DELAY_MIN=0
ACTION_DELAY_MAX=0

# Step screenshots (default on for dry-run only). Field read-back verify (default off).
SCREENSHOTS=false
VERIFY_FILLS=false

# ── Product UI (npm run product) ─────────────────────────────────────────────
PRODUCT_PORT=8787
PRODUCT_DATA_DIR=./data/product
CLIENTS_DIR=./clients
# Public URL you give the client (set after hosting)
PRODUCT_PUBLIC_URL=https://YOUR-HOST
# Operator login token (keep private) — generate with: npm run bootstrap-secrets
OPERATOR_TOKEN=
# Client tokens: id:token,id2:token2  (or use clients/<id>.secrets.json)
CLIENT_API_TOKENS=
